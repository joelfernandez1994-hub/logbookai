{
  "name": "DriverProfile",
  "type": "object",
  "properties": {
    "legal_name": {
      "type": "string"
    },
    "co_driver_id": {
      "type": "string"
    },
    "co_driver_name": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "license_state": {
      "type": "string"
    },
    "signature_data": {
      "type": "string"
    },
    "signature_type": {
      "type": "string",
      "enum": [
        "drawn",
        "typed"
      ],
      "default": "typed"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "home_terminal_timezone": {
      "type": "string",
      "default": "America/Chicago"
    },
    "has_acknowledged_non_eld": {
      "type": "boolean",
      "default": false
    },
    "onboarded": {
      "type": "boolean",
      "default": false
    },
    "entered_prior_history": {
      "type": "boolean",
      "default": false
    },
    "dvir_reminder_enabled": {
      "type": "boolean",
      "default": false
    },
    "live_tracking_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When false, Today's quick 2x2 status selector and Change Status button are paused (greyed out) so the driver can log a day purely via Ask LogbookAI or manual Logs edits without a live real-time status change colliding with it."
    },
    "trip_planning_speed_profile": {
      "type": "string",
      "enum": [
        "conservative",
        "55",
        "60",
        "65",
        "provider"
      ],
      "default": "conservative"
    },
    "ifta_tracking_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Optional, off by default. When true, a background resolver estimates state-by-state mileage from existing trip/location/fuel/odometer data and a separate Reports > IFTA screen appears. Never creates or alters DutyStatusEvent rows and never affects HOS, DVIR, BOL, or normal logging."
    },
    "ifta_base_jurisdiction": {
      "type": "string",
      "description": "Driver's IFTA base jurisdiction (state), for the quarterly report header only. Not required unless IFTA tracking is enabled."
    },
    "ifta_account_number": {
      "type": "string"
    },
    "ifta_fuel_type": {
      "type": "string",
      "enum": [
        "diesel",
        "gasoline",
        "propane",
        "other"
      ],
      "default": "diesel"
    },
    "ifta_default_unit_number": {
      "type": "string"
    },
    "ifta_odometer_preference": {
      "type": "string",
      "enum": [
        "manual",
        "derived",
        "none"
      ],
      "default": "none",
      "description": "How the driver prefers odometer data to factor into IFTA mileage. 'none' means route-estimated mileage is used as-is until the driver confirms or corrects it."
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "es"
      ],
      "default": "en",
      "description": "Display language for the app UI (presentation layer only). Never changes stored duty-status codes or other database values, and never affects official exports (RODS/DVIR/IFTA PDFs and CSVs, certification labels), which always render in English. Ask LogbookAI accepts natural-language input in either English or Spanish regardless of this setting."
    }
  },
  "required": [
    "legal_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}