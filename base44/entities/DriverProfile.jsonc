{
  "name": "DriverProfile",
  "type": "object",
  "properties": {
    "legal_name": {
      "type": "string"
    },
    "co_driver_id": {
      "type": "string"
    },
    "co_driver_name": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "license_state": {
      "type": "string"
    },
    "signature_data": {
      "type": "string"
    },
    "signature_type": {
      "type": "string",
      "enum": [
        "drawn",
        "typed"
      ],
      "default": "typed"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "home_terminal_timezone": {
      "type": "string",
      "default": "America/Chicago"
    },
    "has_acknowledged_non_eld": {
      "type": "boolean",
      "default": false
    },
    "onboarded": {
      "type": "boolean",
      "default": false
    },
    "entered_prior_history": {
      "type": "boolean",
      "default": false
    },
    "dvir_reminder_enabled": {
      "type": "boolean",
      "default": false
    },
    "live_tracking_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When false, Today's quick 2x2 status selector and Change Status button are paused (greyed out) so the driver can log a day purely via Ask LogbookAI or manual Logs edits without a live real-time status change colliding with it."
    },
    "trip_planning_speed_profile": {
      "type": "string",
      "enum": [
        "conservative",
        "55",
        "60",
        "65",
        "provider"
      ],
      "default": "conservative"
    }
  },
  "required": [
    "legal_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}