{
  "name": "DailySummary",
  "type": "object",
  "properties": {
    "log_date": {
      "type": "string",
      "format": "date"
    },
    "miles": {
      "type": "number"
    },
    "miles_source": {
      "type": "string",
      "enum": [
        "auto",
        "manual"
      ],
      "default": "auto"
    },
    "begin_odometer": {
      "type": "number"
    },
    "end_odometer": {
      "type": "number"
    }
  },
  "required": [
    "log_date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}