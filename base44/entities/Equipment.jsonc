{
  "name": "Equipment",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "tractor",
        "trailer",
        "tractor_second"
      ]
    },
    "unit_number": {
      "type": "string"
    },
    "plate_number": {
      "type": "string"
    },
    "plate_state": {
      "type": "string"
    },
    "equipment_details": {
      "type": "string"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "type",
    "unit_number"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}