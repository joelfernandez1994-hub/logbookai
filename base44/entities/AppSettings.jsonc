{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "ai_enabled_global": {
      "type": "boolean",
      "default": true
    },
    "default_ai_allowance": {
      "type": "number",
      "default": 20
    },
    "ruleset_version": {
      "type": "string",
      "default": "US Interstate Property - Standard Federal Rules"
    },
    "settings_key": {
      "type": "string",
      "default": "global"
    },
    "dvir_reminder_enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "settings_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}