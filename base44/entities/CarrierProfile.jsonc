{
  "name": "CarrierProfile",
  "type": "object",
  "properties": {
    "carrier_name": {
      "type": "string"
    },
    "usdot_number": {
      "type": "string"
    },
    "main_office_address": {
      "type": "string"
    },
    "home_terminal_address": {
      "type": "string"
    },
    "home_terminal_city": {
      "type": "string"
    },
    "home_terminal_state": {
      "type": "string"
    },
    "home_terminal_timezone": {
      "type": "string",
      "default": "America/Chicago"
    },
    "hos_cycle": {
      "type": "string",
      "enum": [
        "60_7",
        "70_8"
      ],
      "default": "70_8"
    },
    "ruleset_version": {
      "type": "string",
      "default": "US Interstate Property - Standard Federal Rules"
    }
  },
  "required": [
    "carrier_name",
    "usdot_number",
    "home_terminal_timezone",
    "hos_cycle"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}